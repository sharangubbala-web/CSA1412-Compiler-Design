%{
int nlines = 0, nwords = 0, nchars = 0;
%}

%%

\n {
    nchars++;
    nlines++;
}

[^ \n\t]+ {
    nwords++;
    nchars = nchars + yyleng;
}

. {
    nchars++;
}

%%

int yywrap()
{
    return 1;
}

int main()
{
    yylex();

    printf("Lines = %d\n", nlines);
    printf("Chars = %d\n", nchars);
    printf("Words = %d\n", nwords);

    return 0;
}
