%{
#include <stdio.h>

int positive_no = 0;
int negative_no = 0;
%}

%%

-[0-9]+    {
              negative_no++;
              printf("Negative number = %s\n", yytext);
           }

[0-9]+     {
              positive_no++;
              printf("Positive number = %s\n", yytext);
           }

%%

int yywrap()
{
    return 1;
}

int main()
{
    printf("Enter numbers:\n");
    yylex();

    printf("\nNumber of positive numbers = %d\n", positive_no);
    printf("Number of negative numbers = %d\n", negative_no);

    return 0;
}
